<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The initial probe uses only the installed SDK and Windows Desktop packs. -->
  <packageSources><clear /></packageSources>
  <fallbackPackageFolders><clear /></fallbackPackageFolders>
  <config><add key="globalPackagesFolder" value=".build/nuget/packages" /></config>
</configuration>
