<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Build and checks use the installed SDK and Windows Desktop packs. Publish adds the runtime source explicitly. -->
  <packageSources><clear /></packageSources>
  <fallbackPackageFolders><clear /></fallbackPackageFolders>
  <config><add key="globalPackagesFolder" value=".build/nuget/packages" /></config>
</configuration>
