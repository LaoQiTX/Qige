<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Geometry x:Key="DrawerMenuOpenIcon">M 3,13 L 13,3 M 5,3 L 13,3 L 13,11</Geometry>
  <Geometry x:Key="DrawerMenuLocationIcon">M 2,5 L 2,3 L 6,3 L 8,5 L 14,5 L 14,13 L 2,13 Z</Geometry>
  <Geometry x:Key="DrawerMenuPropertiesIcon">M 4,1.5 L 10,1.5 L 13,4.5 L 13,14.5 L 4,14.5 Z M 10,1.5 L 10,4.5 L 13,4.5 M 6.5,8 L 10.5,8 M 6.5,11 L 10.5,11</Geometry>
  <Geometry x:Key="DrawerMenuReturnIcon">M 6,3 L 3,6 L 6,9 M 3,6 L 10,6 Q 13,6 13,9 L 13,12 L 8,12 M 2,13 L 2,14 L 6,14 L 6,13</Geometry>
  <Geometry x:Key="DrawerMenuManageIcon">M 2,4 L 5,4 M 8,4 L 14,4 M 5,2 L 5,6 M 2,8 L 10,8 M 13,8 L 14,8 M 10,6 L 10,10 M 2,12 L 5,12 M 8,12 L 14,12 M 5,10 L 5,14</Geometry>

  <Style x:Key="DrawerMenuIcon" TargetType="Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#0F1D38" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#E2E8F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="264" />
    <Setter Property="MaxHeight" Value="480" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border x:Name="MenuSurface" Margin="10" CornerRadius="12" Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Border.Effect>
              <DropShadowEffect Color="#0F1D38" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity=".13" />
            </Border.Effect>
            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="#334155" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="ItemSurface" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemSurface" Property="Background" Value="#F1F5F9" />
              <Setter Property="Foreground" Value="#0F1D38" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#93B4EF" />
              <Setter TargetName="ItemSurface" Property="Background" Value="#EFF6FF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemSurface" Property="Opacity" Value=".4" />
              <Setter TargetName="ItemSurface" Property="Background" Value="Transparent" />
              <Setter TargetName="ItemSurface" Property="BorderBrush" Value="Transparent" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DrawerMenuHeading" TargetType="MenuItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <StackPanel Margin="12,8,12,6">
            <TextBlock Text="快捷方式" FontSize="10" Foreground="#64748B" Margin="0,0,0,4" />
            <TextBlock Text="{TemplateBinding Header}" FontSize="12" FontWeight="SemiBold" Foreground="#0F1D38"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="#E9EEF4" Margin="10,5" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
