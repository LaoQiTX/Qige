<Window x:Class="DesktopGroups.StorageWindow" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopGroups" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="栖格 Qige · 桌面管理" Width="1200" Height="780" MinWidth="1100" MinHeight="710" WindowStyle="None" Background="White" Foreground="{x:Static local:AppPalette.Text}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="ManagerKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SharedControls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style TargetType="ListBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Item" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,14" BorderThickness="2,0,0,0" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Item" Property="Background" Value="{x:Static local:AppPalette.Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Item" Property="Background" Value="{x:Static local:AppPalette.Selected}" />
                <Setter TargetName="Item" Property="BorderBrush" Value="{x:Static local:AppPalette.Text}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Item" Property="BorderBrush" Value="{x:Static local:AppPalette.Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{x:Static local:AppPalette.Muted}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="DrawerKindCard" TargetType="RadioButton">
      <Setter Property="Background" Value="{x:Static local:AppPalette.Sidebar}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="CardFrame" Background="{TemplateBinding Background}" BorderBrush="{x:Static local:AppPalette.Divider}" BorderThickness="1" CornerRadius="11" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Ring" Width="14" Height="14" Stroke="{x:Static local:AppPalette.Quiet}" StrokeThickness="1.3" VerticalAlignment="Top" Margin="0,1,12,0" />
                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{x:Static local:AppPalette.Focus}" VerticalAlignment="Top" Margin="0,5,12,0" Visibility="Hidden" />
                <ContentPresenter Grid.Column="1" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardFrame" Property="Background" Value="{x:Static local:AppPalette.Control}" /></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CardFrame" Property="Background" Value="{x:Static local:AppPalette.Selected}" />
                <Setter TargetName="CardFrame" Property="BorderBrush" Value="{x:Static local:AppPalette.Accent}" />
                <Setter TargetName="Ring" Property="Stroke" Value="{x:Static local:AppPalette.Focus}" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardFrame" Property="BorderBrush" Value="{x:Static local:AppPalette.Focus}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{x:Static local:AppPalette.DisabledText}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{x:Static local:AppPalette.Muted}" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Frame" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="White" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:AppPalette.Divider}" />
                <Setter Property="Foreground" Value="{x:Static local:AppPalette.Text}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{x:Static local:AppPalette.Focus}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:AppPalette.Focus}" />
              </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{x:Static local:AppPalette.DisabledText}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{x:Static local:AppPalette.Sidebar}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{x:Static local:AppPalette.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="BentoItem" TargetType="ListBoxItem">
      <EventSetter Event="MouseDoubleClick" Handler="CanvasDrawerDoubleClick" />
      <Setter Property="ToolTip" Value="双击打开此抽屉，管理内容" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Padding="16" Margin="3,3,11,13" CornerRadius="14" Background="White" BorderThickness="1" BorderBrush="{x:Static local:AppPalette.Divider}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:AppPalette.Quiet}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:AppPalette.Focus}" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                <Setter TargetName="Frame" Property="Padding" Value="15" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:AppPalette.Focus}" />
              </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{x:Static local:AppPalette.DisabledText}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="IconTile">
      <StackPanel Width="64" Margin="0,7" ToolTip="{Binding Detail}">
        <Border Width="36" Height="36" Background="White" CornerRadius="8" BorderBrush="{x:Static local:AppPalette.Divider}" BorderThickness="1">
          <Grid>
            <TextBlock Text="↗" Foreground="{x:Static local:AppPalette.Quiet}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
        </Border>
        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{x:Static local:AppPalette.Muted}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="2,6,2,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ContentRow">
      <Border BorderBrush="{x:Static local:AppPalette.Control}" BorderThickness="0,0,0,1" Padding="0,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,5,0">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
            <TextBlock Text="{Binding Detail}" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="移除引用" Visibility="{Binding CanUnlink, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuietButton}" Click="RemoveReferenceClick" Padding="6,5" />
            <Button Content="打开" IsEnabled="{Binding CanOpen}" Style="{StaticResource QuietButton}" Click="OpenItemClick" Padding="6,5" />
            <Button Content="归还" IsEnabled="{Binding CanReturn}" Foreground="{x:Static local:AppPalette.Focus}" Background="Transparent" Padding="6,5" Click="ReturnItemClick" ToolTip="归还桌面并解除此项分组" />
            <Button Content="移除失效记录" Click="DismissMissingContentClick" Foreground="#9A3412" Background="Transparent" Padding="6,5" ToolTip="从抽屉移除失效成员，保留历史副本">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding CanDismiss}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{x:Static local:AppPalette.Secondary}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{x:Static local:AppPalette.Divider}" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="White" BorderBrush="{x:Static local:AppPalette.Divider}" BorderThickness="1" CornerRadius="7">
                      <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{x:Static local:AppPalette.Muted}" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" Margin="10,5,30,5" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="{x:Static local:AppPalette.Divider}" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Padding="4">
                  <ScrollViewer>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Toggle" Property="Opacity" Value=".7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioSearch" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Path Data="M 10.5,6 A 4.5,4.5 0 1 1 1.5,6 A 4.5,4.5 0 1 1 10.5,6 M 9.5,9.5 L 13,13" Width="14" Height="14" Stretch="Uniform" Stroke="{x:Static local:AppPalette.Quiet}" StrokeThickness="1.2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                <ScrollViewer x:Name="PART_ContentHost" Margin="33,6,10,6" VerticalAlignment="Center" />
                <TextBlock x:Name="Hint" Text="搜索抽屉或文件..." Foreground="{x:Static local:AppPalette.Quiet}" Margin="33,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioDrawerItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="Foreground" Value="{x:Static local:AppPalette.Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="10,11" Margin="0,0,0,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{x:Static local:AppPalette.Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="White" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:AppPalette.Divider}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:AppPalette.Focus}" />
              </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{x:Static local:AppPalette.DisabledText}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="StudioDrawerTemplate">
      <Grid MinHeight="30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="33" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="25" Height="25" Background="{x:Static local:AppPalette.Control}" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Path Data="{Binding NavigationIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{x:Static local:AppPalette.Secondary}" StrokeThickness="1.4" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Normal" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding NavigationSubtitle}" FontSize="10" Foreground="{x:Static local:AppPalette.Quiet}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0,3,0,0">
          <Ellipse Width="6" Height="6" Visibility="{Binding NavigationDotVisibility}" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="#CBD5E1" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Fill" Value="{x:Static local:AppPalette.Focus}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <Border Background="{x:Static local:AppPalette.Control}" CornerRadius="4" Padding="4,1" Visibility="{Binding NavigationBadgeVisibility}" ToolTip="{Binding Issue}">
            <TextBlock Text="{Binding NavigationBadge}" FontSize="9" Foreground="{x:Static local:AppPalette.Muted}" />
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Border BorderBrush="#DCE2EB" BorderThickness="1" CornerRadius="12" Background="White">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition />
        <RowDefinition Height="36" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{x:Static local:AppPalette.Control}" BorderThickness="0,0,0,1" Padding="18,0,10,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="24" Height="24" Margin="0,0,9,0">
              <Canvas Width="100" Height="100">
                <Path Data="M 80,44 L 80,28 C 80,21.37 74.63,16 68,16 L 28,16 C 21.37,16 16,21.37 16,28 L 16,72 C 16,78.63 21.37,84 28,84 L 44,84" Stroke="{x:Static local:AppPalette.Text}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Rectangle Canvas.Left="54" Canvas.Top="58" Width="28" Height="28" RadiusX="8" RadiusY="8" Fill="{x:Static local:AppPalette.Focus}" />
              </Canvas>
            </Viewbox>
            <Image x:Name="BrandIcon" Visibility="Collapsed" />
            <TextBlock Text="栖格 Qige" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text=" / " Foreground="#CBD5E1" Margin="8,0" VerticalAlignment="Center" />
            <TextBlock Text="桌面管理" Foreground="{x:Static local:AppPalette.Muted}" FontSize="11" VerticalAlignment="Center" />
            <Border Background="{x:Static local:AppPalette.Sidebar}" BorderBrush="{x:Static local:AppPalette.Divider}" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="10,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Fill="{x:Static local:AppPalette.Focus}" Width="5" Height="5" Margin="0,0,6,0" />
                <TextBlock x:Name="ConnectionLabel" Text="正在连接桌面" FontSize="10" Foreground="{x:Static local:AppPalette.Muted}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Grid.Column="1" Background="{x:Static local:AppPalette.Control}" BorderBrush="#E8EDF3" BorderThickness="1" CornerRadius="10" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="CanvasModeButton" GroupName="MainMode" Content="▦  空间沙盘" Style="{StaticResource Segment}" IsChecked="True" Click="CanvasModeClick" />
              <RadioButton x:Name="StudioModeButton" GroupName="MainMode" Content="☷  工作台详情" Style="{StaticResource Segment}" Click="StudioModeClick" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="＋ 新建抽屉" Style="{StaticResource PrimaryButton}" Click="NewDrawerClick" Padding="11,6" />
            <TextBlock Text="关闭后常驻" FontSize="10" Foreground="{x:Static local:AppPalette.Quiet}" Margin="10,0,6,0" VerticalAlignment="Center" />
            <Button Content="─" Width="30" Padding="0,6" Style="{StaticResource QuietButton}" Click="MinimizeClick" ToolTip="最小化" AutomationProperties.Name="最小化" />
            <Button Content="□" Width="30" Padding="0,6" Style="{StaticResource QuietButton}" Click="MaximizeClick" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原" />
            <Button Content="✕" Width="30" Padding="0,6" Style="{StaticResource QuietButton}" Click="ClosePanelClick" ToolTip="关闭面板" AutomationProperties.Name="关闭面板" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid x:Name="CanvasView">
            <Grid.Background>
              <DrawingBrush TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                  <DrawingGroup>
                    <GeometryDrawing Brush="#F5F7FA">
                      <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,18,18" />
                      </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#DFE5EF">
                      <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1,1" RadiusX=".7" RadiusY=".7" />
                      </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                  </DrawingGroup>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="24,22,24,14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="DESKTOP CANVAS" FontFamily="Consolas" FontWeight="Bold" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="11" />
                <TextBlock Text=" · 桌面抽屉总览" Foreground="{x:Static local:AppPalette.Muted}" FontSize="11" />
              </StackPanel>
              <ComboBox x:Name="CanvasMonitorBox" Grid.Row="1" DisplayMemberPath="Label" Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="210" MaxWidth="430" FontSize="11" Padding="8,4" SelectionChanged="CanvasMonitorChanged" AutomationProperties.Name="沙盘显示器筛选" />
            </Grid>
            <ScrollViewer x:Name="CanvasScroll" Grid.Row="1" PreviewMouseWheel="CanvasScrollWheel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="21,0,13,16">
              <StackPanel>
                <ListBox x:Name="CanvasDrawerList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource BentoItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="CanvasSelectionChanged" AutomationProperties.Name="空间沙盘抽屉">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="202">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <Border Width="28" Height="28" Background="{x:Static local:AppPalette.Control}" CornerRadius="8" HorizontalAlignment="Left">
                            <TextBlock Text="▤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                          </Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Placement}" FontSize="10" Foreground="{x:Static local:AppPalette.Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
