<Window x:Class="DesktopGroups.StorageWindow" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopGroups" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="栖格 Qige · 桌面管理" Width="1200" Height="780" MinWidth="1100" MinHeight="710" WindowStyle="None" Background="White" Foreground="#0F1D38" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="ManagerKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderBrush="#2563EB" BorderThickness="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value=".82" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value=".6" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderThickness" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value=".4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0F1D38" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#0F1D38" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="CaretBrush" Value="#0F1D38" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#2563EB" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#CBD5E1" CornerRadius="3" Margin="2,1" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,20,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="Box" Width="14" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="#94A3B8" Background="#FFFFFF" Margin="0,0,7,0">
                <Path x:Name="Tick" Data="M 2,6 L 5,9 L 10,3" Stroke="#FFFFFF" StrokeThickness="1.6" Visibility="Collapsed" />
              </Border>
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#2563EB" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#475569" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Item" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,14" BorderThickness="2,0,0,0" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Item" Property="Background" Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Item" Property="Background" Value="#EFF6FF" />
                <Setter TargetName="Item" Property="BorderBrush" Value="#0F1D38" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Item" Property="BorderBrush" Value="#0F1D38" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Frame" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="White" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="Foreground" Value="#0F1D38" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#2563EB" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#2563EB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="BentoItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Padding="16" Margin="3,3,11,13" CornerRadius="14" Background="White" BorderThickness="1" BorderBrush="#E2E8F0">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#94A3B8" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#2563EB" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                <Setter TargetName="Frame" Property="Padding" Value="15" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#2563EB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="IconTile">
      <StackPanel Width="64" Margin="0,7" ToolTip="{Binding Detail}">
        <Border Width="36" Height="36" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
          <Grid>
            <TextBlock Text="↗" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
        </Border>
        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="2,6,2,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ContentRow">
      <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,5,0">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
            <TextBlock Text="{Binding Detail}" Foreground="#94A3B8" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="打开" Style="{StaticResource QuietButton}" Click="OpenItemClick" Padding="6,5" />
            <Button Content="归还" IsEnabled="{Binding CanReturn}" Foreground="#2563EB" Background="Transparent" Padding="6,5" Click="ReturnItemClick" ToolTip="归还桌面并解除此项分组" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                      <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#64748B" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" Margin="10,5,30,5" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Padding="4">
                  <ScrollViewer>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Toggle" Property="Opacity" Value=".7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioSearch" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9">
              <Grid>
                <Path Data="M 10.5,6 A 4.5,4.5 0 1 1 1.5,6 A 4.5,4.5 0 1 1 10.5,6 M 9.5,9.5 L 13,13" Width="14" Height="14" Stretch="Uniform" Stroke="#94A3B8" StrokeThickness="1.2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                <ScrollViewer x:Name="PART_ContentHost" Margin="33,6,10,6" VerticalAlignment="Center" />
                <TextBlock x:Name="Hint" Text="搜索抽屉或文件..." Foreground="#94A3B8" Margin="33,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#2563EB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioDrawerItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="Foreground" Value="#0F1D38" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="10,11" Margin="0,0,0,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="#F1F2F5" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="White" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="#E2E8F0" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#2563EB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="StudioDrawerTemplate">
      <Grid MinHeight="30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="33" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="25" Height="25" Background="#F1F5F9" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Path Data="{Binding NavigationIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="#475569" StrokeThickness="1.4" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Normal" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding NavigationSubtitle}" FontSize="10" Foreground="#94A3B8" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0,3,0,0">
          <Ellipse Width="6" Height="6" Visibility="{Binding NavigationDotVisibility}" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="#CBD5E1" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Fill" Value="#2563EB" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <Border Background="#F1F5F9" CornerRadius="4" Padding="4,1" Visibility="{Binding NavigationBadgeVisibility}" ToolTip="{Binding Issue}">
            <TextBlock Text="{Binding NavigationBadge}" FontSize="9" Foreground="#64748B" />
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Border BorderBrush="#DCE2EB" BorderThickness="1" CornerRadius="12" Background="White">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition />
        <RowDefinition Height="36" />
      </Grid.RowDefinitions>
      <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="18,0,10,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="24" Height="24" Margin="0,0,9,0">
              <Canvas Width="100" Height="100">
                <Path Data="M 80,44 L 80,28 C 80,21.37 74.63,16 68,16 L 28,16 C 21.37,16 16,21.37 16,28 L 16,72 C 16,78.63 21.37,84 28,84 L 44,84" Stroke="#0F1D38" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Rectangle Canvas.Left="54" Canvas.Top="58" Width="28" Height="28" RadiusX="8" RadiusY="8" Fill="#2563EB" />
              </Canvas>
            </Viewbox>
            <Image x:Name="BrandIcon" Visibility="Collapsed" />
            <TextBlock Text="栖格 Qige" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text=" / " Foreground="#CBD5E1" Margin="8,0" VerticalAlignment="Center" />
            <TextBlock Text="桌面管理" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="10,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Fill="#2563EB" Width="5" Height="5" Margin="0,0,6,0" />
                <TextBlock x:Name="ConnectionLabel" Text="正在连接桌面" FontSize="10" Foreground="#64748B" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#E8EDF3" BorderThickness="1" CornerRadius="10" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="CanvasModeButton" GroupName="MainMode" Content="▦  空间沙盘" Style="{StaticResource Segment}" IsChecked="True" Click="CanvasModeClick" />
              <RadioButton x:Name="StudioModeButton" GroupName="MainMode" Content="☷  工作台详情" Style="{StaticResource Segment}" Click="StudioModeClick" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="＋ 新建抽屉" Style="{StaticResource PrimaryButton}" Click="NewDrawerClick" Padding="11,6" />
            <TextBlock Text="关闭后常驻" FontSize="10" Foreground="#94A3B8" Margin="10,0,6,0" VerticalAlignment="Center" />
            <Button Content="─" Width="30" Padding="0,6" Style="{StaticResource QuietButton}" Click="MinimizeClick" ToolTip="最小化" AutomationProperties.Name="最小化" />
            <Button Content="□" Width="30" Padding="0,6" Style="{StaticResource QuietButton}" Click="MaximizeClick" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原" />
            <Button Content="✕" Width="30" Padding="0,6" Style="{StaticResource QuietButton}" Click="ClosePanelClick" ToolTip="关闭面板" AutomationProperties.Name="关闭面板" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid x:Name="CanvasView">
            <Grid.Background>
              <DrawingBrush TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                  <DrawingGroup>
                    <GeometryDrawing Brush="#F8FAFC">
                      <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,18,18" />
                      </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#DFE5EF">
                      <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1,1" RadiusX=".7" RadiusY=".7" />
                      </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                  </DrawingGroup>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="24,22,24,14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="DESKTOP CANVAS" FontFamily="Consolas" FontWeight="Bold" Foreground="#94A3B8" FontSize="11" />
                <TextBlock Text=" · 桌面抽屉总览" Foreground="#64748B" FontSize="11" />
              </StackPanel>
              <ComboBox x:Name="CanvasMonitorBox" Grid.Row="1" DisplayMemberPath="Label" Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="210" MaxWidth="430" FontSize="11" Padding="8,4" SelectionChanged="CanvasMonitorChanged" AutomationProperties.Name="沙盘显示器筛选" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="21,0,13,16">
              <StackPanel>
                <ListBox x:Name="CanvasDrawerList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource BentoItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="CanvasSelectionChanged" AutomationProperties.Name="空间沙盘抽屉">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="202">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="28" Height="28" Background="#F1F5F9" CornerRadius="8" HorizontalAlignment="Left">
                            <TextBlock Text="▤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                          </Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Placement}" FontSize="10" Foreground="#64748B" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="2" Content="⌖" Padding="6,2" FontSize="17" Click="LocateCardClick" ToolTip="在桌面闪烁定位" AutomationProperties.Name="定位此抽屉" />
                        </Grid>
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="10" Margin="0,16,0,14" Padding="4,6">
                          <Grid>
                            <ItemsControl ItemsSource="{Binding Preview}" ItemTemplate="{StaticResource IconTile}" VerticalAlignment="Center">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="把桌面快捷方式拖入此抽屉" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyVisibility}" />
                          </Grid>
                        </Border>
                        <Grid Grid.Row="2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Summary}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Issue}" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Content="归还至桌面" Style="{StaticResource QuietButton}" Padding="0,2" FontSize="10" Click="RestoreCardClick" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="CanvasEmptyView" Visibility="Collapsed" Margin="20,50" HorizontalAlignment="Center">
                  <TextBlock Text="这里还没有抽屉" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="创建抽屉，或切换显示器查看。" Foreground="#64748B" Margin="0,12,0,22" />
                  <Button Content="＋ 新建抽屉" Click="NewDrawerClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="24,0" Padding="0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="各抽屉独立保存布局与分组记忆" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="偏好设置" Click="PreferencesClick" Style="{StaticResource QuietButton}" Padding="6,2" />
              </Grid>
            </Border>
          </Grid>
          <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="StudioView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="250" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="StudioSidebar" Background="#FAFAFC" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="14,16,14,10">
              <DockPanel LastChildFill="True">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="SearchChanged" Style="{StaticResource StudioSearch}" AutomationProperties.Name="搜索抽屉或文件" ToolTip="搜索抽屉或文件" Margin="0,0,0,16" />
                <Border DockPanel.Dock="Bottom" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="2,10,0,0" Margin="0,12,0,0">
                  <Button x:Name="StudioPreferencesButton" Click="PreferencesClick" Style="{StaticResource QuietButton}" Padding="8,6" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <TextBlock Text="偏好设置" Foreground="#475569" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <ListBox x:Name="DrawerList" SelectionChanged="SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource StudioDrawerItem}" ItemTemplate="{StaticResource StudioDrawerTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="抽屉列表">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.GroupStyle>
                        <GroupStyle>
                          <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="GroupItem">
                                    <StackPanel Margin="0,0,0,18">
                                      <Grid Margin="8,0,8,8">
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition />
                                          <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding ItemCount}" FontFamily="Consolas" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                      </Grid>
                                      <ItemsPresenter />
                                    </StackPanel>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </GroupStyle.ContainerStyle>
                        </GroupStyle>
                      </ListBox.GroupStyle>
                    </ListBox>
                    <StackPanel x:Name="StudioNoMatches" Visibility="Collapsed" Margin="8,8,8,20">
                      <TextBlock Text="没有找到匹配的抽屉或文件" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="8,5,8,0">
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件夹映射抽屉" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                        <TextBlock Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="10" Foreground="#94A3B8" />
                      </Grid>
                      <TextBlock Text="当前版本暂未支持" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,8" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="22,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock x:Name="StudioTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StudioSubtitle" Foreground="#94A3B8" FontSize="10" Margin="0,7,0,14" />
                <WrapPanel Margin="0,0,0,14">
                  <Button Content="⌖ 桌面定位" Click="LocateClick" Padding="10,6" Margin="0,0,8,4" />
                  <Button Content="归还内容" Click="RestoreClick" Background="White" Padding="10,6" Margin="0,0,0,4" />
                </WrapPanel>
                <Border Height="1" Background="#F1F5F9" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock x:Name="StudioEmptyLabel" Text="此抽屉暂无入口，或没有匹配的搜索结果。" TextWrapping="Wrap" Foreground="#94A3B8" Margin="0,30,0,0" />
                  <ItemsControl x:Name="StudioContentsList" ItemTemplate="{StaticResource ContentRow}" />
                </StackPanel>
              </ScrollViewer>
              <Button Grid.Row="2" Content="重新收纳散落入口" Click="RecollectClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,12,0,0" />
            </Grid>
          </Grid>
        </Grid>
        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,22,22,16">
              <StackPanel x:Name="EmptyView" Visibility="Collapsed" Margin="0,40,0,0">
                <TextBlock Text="给桌面一个新的位置" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="选择或新建一个抽屉，查看内容与属性。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,14,0,22" />
                <Button Content="创建第一个抽屉" Click="NewDrawerClick" Style="{StaticResource PrimaryButton}" />
              </StackPanel>
              <StackPanel x:Name="DetailView">
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="当前所选抽屉" Foreground="#64748B" FontSize="11" />
                  <Border Grid.Column="1" Background="#F1F5F9" Padding="7,3" CornerRadius="4">
                    <TextBlock Text="桌面整理" FontSize="10" Foreground="#64748B" />
                  </Border>
                </Grid>
                <TextBlock x:Name="SelectedTitle" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectedSubtitle" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,7,0,13" />
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="NameBox" MaxLength="40" KeyDown="RenameKeyDown" AutomationProperties.Name="抽屉名称" Padding="8,6" />
                  <Button Grid.Column="1" Content="保存" Click="RenameClick" Margin="7,0,0,0" Padding="10,6" />
                </Grid>
                <TextBlock x:Name="DrawerIssueLabel" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#A33F3F" Margin="0,0,0,12" />
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Margin="0,0,0,7">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="ContentsTitle" Text="内容透视" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="#E9EEF5" CornerRadius="6" Padding="1">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="GridViewButton" GroupName="PreviewMode" Content="▦" Style="{StaticResource Segment}" Padding="7,3" IsChecked="True" Click="GridPreviewClick" ToolTip="网格预览" />
                          <RadioButton x:Name="ListViewButton" GroupName="PreviewMode" Content="☷" Style="{StaticResource Segment}" Padding="7,3" Click="ListPreviewClick" ToolTip="列表预览" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock x:Name="NoContentsLabel" Text="还没有入口。将桌面快捷方式拖入抽屉。" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11" Margin="0,10" />
                    <ScrollViewer MaxHeight="155" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="ContentsList" ItemTemplate="{StaticResource IconTile}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="桌面物理行为" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Border Background="#E9EEF5" CornerRadius="7" Padding="2" Margin="0,0,0,12">
                      <UniformGrid Columns="2">
                        <RadioButton x:Name="AlwaysModeButton" GroupName="FoldMode" Content="常驻展开" Style="{StaticResource Segment}" Padding="8,6" Click="AlwaysModeClick" />
                        <RadioButton x:Name="HoverModeButton" GroupName="FoldMode" Content="悬停展开" Style="{StaticResource Segment}" Padding="8,6" Click="HoverModeClick" />
                      </UniformGrid>
                    </Border>
                    <CheckBox x:Name="FoldBox" Visibility="Collapsed" Click="FoldClick" />
                    <CheckBox x:Name="LockBox" Content="锁定位置，避免误拖动" Click="LockClick" Margin="0,0,0,12" />
                    <CheckBox x:Name="SnapBox" Content="屏幕边缘磁吸与对齐辅助线" Click="SnapClick" Margin="0" />
                    <TextBlock Text="按住 Alt 可临时自由拖动" Foreground="#94A3B8" FontSize="10" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Expander Header="显示器、位置与尺寸" Foreground="#64748B" Margin="0,0,0,14">
                  <StackPanel Margin="0,12,0,0">
                    <ComboBox x:Name="TargetMonitorBox" DisplayMemberPath="Label" SelectionChanged="TargetMonitorChanged" FontSize="11" Padding="7,5" Margin="0,0,0,12" AutomationProperties.Name="目标显示器" />
                    <UniformGrid Columns="2">
                      <StackPanel Margin="0,0,8,10">
                        <TextBlock Text="横向位置" FontSize="10" Foreground="#94A3B8" />
                        <TextBox x:Name="XBox" AutomationProperties.Name="横向位置" />
                      </StackPanel>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="纵向位置" FontSize="10" Foreground="#94A3B8" />
                        <TextBox x:Name="YBox" AutomationProperties.Name="纵向位置" />
                      </StackPanel>
                      <StackPanel Margin="0,0,8,10">
                        <TextBlock Text="宽度" FontSize="10" Foreground="#94A3B8" />
                        <TextBox x:Name="WidthBox" AutomationProperties.Name="抽屉宽度" />
                      </StackPanel>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="高度" FontSize="10" Foreground="#94A3B8" />
                        <TextBox x:Name="HeightBox" AutomationProperties.Name="抽屉高度" />
                      </StackPanel>
                    </UniformGrid>
                    <Button x:Name="ApplyLayoutButton" Content="应用布局" Click="ApplyLayoutClick" />
                    <local:LayoutOverview x:Name="Overview" Height="110" Margin="0,12,0,0" />
                    <TextBlock Text="桌面布局 · 点击预览切换抽屉" FontSize="10" Foreground="#94A3B8" Margin="0,6,0,0" />
                  </StackPanel>
                </Expander>
                <Button Content="归还全部内容至桌面" Click="RestoreClick" Background="#F1F5F9" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button Content="重新收纳散落入口" Click="RecollectClick" FontSize="11" Padding="8,7" />
                  <Button Grid.Column="1" Content="解除分组" Click="RemoveClick" Style="{StaticResource QuietButton}" Margin="8,0,0,0" FontSize="11" />
                </Grid>
                <WrapPanel Margin="0,6,0,8">
                  <Button x:Name="AddSelectedButton" Content="收纳桌面选中" Click="AddSelectedClick" Style="{StaticResource QuietButton}" FontSize="10" />
                  <Button Content="打开收纳目录" Click="OpenFolderClick" Style="{StaticResource QuietButton}" FontSize="10" />
                </WrapPanel>
                <TextBlock Text="退出时归还已收纳的入口；遇到同名冲突会保留文件与恢复记录。" Foreground="#94A3B8" TextWrapping="Wrap" FontSize="10" LineHeight="17" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="18,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusLabel" Text="关闭面板后，桌面抽屉继续运行。" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="VersionLabel" Grid.Column="1" Foreground="#94A3B8" FontFamily="Consolas" FontSize="10" Margin="14,0" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="退出并归还全部" Click="ExitClick" Style="{StaticResource QuietButton}" FontSize="10" Padding="5,3" />
        </Grid>
      </Border>
      <Grid x:Name="ModalLayer" Grid.RowSpan="3" Background="#400F1D38" Visibility="Collapsed" Panel.ZIndex="10" KeyboardNavigation.TabNavigation="Cycle" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Border x:Name="CreateBox" Visibility="Collapsed" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Width="490" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="新建桌面抽屉" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20" />
            <Border BorderBrush="#0F1D38" BorderThickness="2" Background="#F8FAFC" CornerRadius="11" Padding="15" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="●  桌面整理抽屉" FontWeight="SemiBold" />
                <TextBlock Text="收纳桌面快捷方式，归还时保留分组与位置记忆。" Foreground="#64748B" TextWrapping="Wrap" FontSize="11" Margin="17,8,0,0" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC" CornerRadius="11" Padding="16" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="○  文件夹映射抽屉 · 即将支持" Foreground="#94A3B8" FontWeight="SemiBold" />
                <TextBlock Text="直接查看本地文件夹。当前版本尚未提供此类型。" Foreground="#94A3B8" TextWrapping="Wrap" FontSize="11" Margin="17,8,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="抽屉名称" Margin="0,0,0,7" />
            <TextBox x:Name="NewNameBox" MaxLength="40" KeyDown="NewNameKeyDown" AutomationProperties.Name="新抽屉名称" />
            <TextBlock x:Name="CreateErrorLabel" TextWrapping="Wrap" Foreground="#A33F3F" Visibility="Collapsed" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
              <Button Content="取消" Click="CancelCreateClick" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
              <Button Content="创建并在桌面放置" Click="CreateClick" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border x:Name="PreferencesBox" Visibility="Collapsed" Background="White" CornerRadius="16" Width="440" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="全局偏好设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,22" />
            <CheckBox x:Name="StartupBox" Content="登录 Windows 后自动启动栖格" Click="StartupClick" Margin="0,0,0,16" />
            <TextBlock Text="吸附与对齐设置对全部抽屉生效，可在右侧桌面物理行为中调整。" Foreground="#64748B" TextWrapping="Wrap" LineHeight="20" />
            <TextBlock Text="关闭管理面板后，栖格在系统托盘保持运行。" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,14,0,22" />
            <Button Content="完成" Click="DismissModalClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
        <Border x:Name="CloseBox" Visibility="Collapsed" Background="White" CornerRadius="16" Width="450" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="关闭管理面板" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Text="选择桌面抽屉接下来如何运行。" Foreground="#64748B" Margin="0,0,0,20" />
            <Button Click="KeepRunningClick" Background="#F8FAFC" Padding="16,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="关闭面板，保持桌面抽屉运行" FontWeight="SemiBold" />
                <TextBlock Text="可从系统托盘重新打开管理面板" Foreground="#64748B" FontSize="11" Margin="0,6,0,0" />
              </StackPanel>
            </Button>
            <Button Click="ExitClick" Background="#F1F5F9" Padding="16,14">
              <StackPanel>
                <TextBlock Text="完全退出栖格，归还全部内容" />
                <TextBlock Text="若发生归还冲突，将保留恢复记录并提示" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0" />
              </StackPanel>
            </Button>
            <Button Content="取消" Click="DismissModalClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,16,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>