                    <TextBlock x:Name="StudioTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="StudioSubtitle" Foreground="{x:Static local:AppPalette.Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="AddContentsMenuButton" Grid.Column="1" Click="AddContentsMenuClick" Margin="14,0,0,0"
                          Padding="11,6" MinHeight="32" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                          AutomationProperties.Name="添加内容" AutomationProperties.HelpText="打开收纳、引用和新建网址选项">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="M 1,5 L 9,5 M 5,1 L 5,9" Stroke="White" StrokeThickness="1.3" VerticalAlignment="Center" Margin="0,0,7,0" />
                      <TextBlock Text="添加内容" />
                      <Path Data="M 1,1 L 4,4 L 7,1" Stroke="White" StrokeThickness="1.3" VerticalAlignment="Center" Margin="7,0,0,0" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Grid x:Name="ContentActions" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="MappedOperationsButton" HorizontalAlignment="Left" MinHeight="30" Content="整理操作 ▾"
                          Click="MappedOperationsClick" Padding="10,4" AutomationProperties.Name="整理操作" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="SortContentButton" Content="排序 ▾" Click="SortContentClick" MinHeight="30" Padding="9,4"
                            Style="{StaticResource QuietButton}" AutomationProperties.Name="排序" />
                    <Button x:Name="RefreshContentButton" Content="刷新" Click="RefreshContentClick" MinHeight="30" Padding="9,4"
                            Style="{StaticResource QuietButton}" />
                  </StackPanel>
                </Grid>
                <Button x:Name="CancelTransferButton" Content="取消传输" Visibility="Collapsed" Click="CancelTransferClick" HorizontalAlignment="Left" Margin="0,0,6,6" Padding="10,7" />
                <TextBlock x:Name="StudioExternalIssue" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#9A3412" Margin="0,0,0,10" />
                <Border Height="1" Background="{x:Static local:AppPalette.Control}" />
              </StackPanel>
              <Grid Grid.Row="1">
                <ListBox x:Name="StudioContentsList" ItemTemplate="{StaticResource ContentRow}" SelectionMode="Extended"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
