              <ColumnDefinition Width="250" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="StudioSidebar" Background="#FAFAFC" BorderBrush="{x:Static local:AppPalette.Control}" BorderThickness="0,0,1,0" Padding="14,16,14,10">
