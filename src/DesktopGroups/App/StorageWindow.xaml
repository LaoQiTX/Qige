                <ColumnDefinition Width="160" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border BorderBrush="{x:Static local:AppPalette.Control}" BorderThickness="0,0,1,0" Padding="0,0,18,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Bottom" Text="通用偏好即时保存&#x0a;备份参数需点击保存" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="10" LineHeight="18" Margin="8,16,0,0" />
                  <StackPanel>
                    <RadioButton x:Name="GeneralSettingsTab" GroupName="SettingsSection" Content="通用设置" Style="{StaticResource Segment}" Padding="10,11" Margin="0,0,0,5" Click="GeneralSettingsClick" />
                    <RadioButton x:Name="RecoverySettingsTab" GroupName="SettingsSection" Content="运行与恢复" Style="{StaticResource Segment}" Padding="10,11" Margin="0,0,0,5" Click="RecoverySettingsClick" />
                    <RadioButton x:Name="AboutSettingsTab" GroupName="SettingsSection" Content="关于与帮助" Style="{StaticResource Segment}" Padding="10,11" Click="AboutSettingsClick" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,8,0">
                <Grid>
                  <StackPanel x:Name="GeneralSettingsPage">
                    <TextBlock Text="通用设置" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="启动和布局偏好，与当前选择的抽屉无关。" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,22" />
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="启动" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <CheckBox x:Name="StartupBox" Content="登录 Windows 后自动启动栖格" Click="StartupClick" Margin="0" />
                        <TextBlock x:Name="StartupSettingsNote" Text="登录后优先恢复桌面抽屉，在系统托盘运行；点击托盘打开管理面板。" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="21,8,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="吸附与对齐" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <CheckBox x:Name="SnapBox" Content="启用屏幕与抽屉之间的吸附" Click="SnapClick" Margin="0" />
                        <TextBlock Text="对齐边缘与中心线时显示辅助线；按住 Alt 可临时自由拖动。" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="21,8,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="备份与恢复" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <CheckBox x:Name="AutoBackupBox" Content="自动备份配置与托管内容" Margin="0,0,0,12" />
                        <TextBlock Text="备份目录" FontSize="11" Foreground="{x:Static local:AppPalette.Muted}" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,12">
                          <Button DockPanel.Dock="Right" Content="选择…" Click="ChooseBackupDirectoryClick" Margin="8,0,0,0" />
                          <TextBox x:Name="BackupDirectoryBox" AutomationProperties.Name="备份目录" />
                        </DockPanel>
                        <WrapPanel Margin="0,0,0,12">
                          <TextBlock Text="间隔（分钟）" VerticalAlignment="Center" FontSize="11" />
                          <TextBox x:Name="BackupIntervalBox" Width="65" Margin="8,0,16,0" AutomationProperties.Name="备份间隔分钟" />
                          <TextBlock Text="保留自动备份" VerticalAlignment="Center" FontSize="11" />
                          <TextBox x:Name="BackupRetainBox" Width="55" Margin="8,0,0,0" AutomationProperties.Name="自动备份保留数量" />
                        </WrapPanel>
                        <TextBlock Text="默认每小时备份，配置变化稳定两分钟后也会备份。手动及恢复前的备份长期保留；外部文件不在备份范围内。" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />
                        <WrapPanel>
                          <Button Content="保存备份设置" Click="SaveBackupSettingsClick" Margin="0,0,8,8" />
                          <Button x:Name="BackupNowButton" Content="立即备份" Click="BackupNowClick" Margin="0,0,8,8" />
                          <Button Content="打开备份目录" Click="OpenBackupFolderClick" Margin="0,0,8,8" />
                        </WrapPanel>
                                                <TextBlock Text="备份含托管文件和文件夹。外部目录与引用仅保存路径。每份备份最多 20,000 项及 512 MB。" Foreground="{x:Static local:AppPalette.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4" />
                        <TextBlock x:Name="BackupStatusLabel" Foreground="{x:Static local:AppPalette.Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,12" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="选择当前数据目录的备份以恢复" FontSize="11" Foreground="{x:Static local:AppPalette.Muted}" Margin="0,0,0,6" />
                        <ComboBox x:Name="BackupList" DisplayMemberPath="Label" MinHeight="32" AutomationProperties.Name="可恢复备份" />
                        <WrapPanel Margin="0,10,0,0">
                          <Button Content="刷新列表" Click="RefreshBackupsClick" Margin="0,0,8,0" />
                          <Button x:Name="RestoreBackupButton" Content="恢复所选备份…" Click="RestoreBackupClick" IsEnabled="False" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="关闭管理面板时，可选择继续在托盘运行，或归还全部内容后退出。" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="11" TextWrapping="Wrap" LineHeight="19" />
                  </StackPanel>
                  <StackPanel x:Name="RecoverySettingsPage" Visibility="Collapsed">
                    <TextBlock Text="运行与恢复" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="HealthSummary" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock x:Name="HealthEnvironment" Foreground="{x:Static local:AppPalette.Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,14" />
                    <TextBlock x:Name="TransferRecoveryLabel" Visibility="Collapsed" Foreground="#9A3412" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <TextBlock Text="以下操作作用于全部抽屉" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="10" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,14">
                      <Button Content="重新连接桌面" Click="RetryDesktopClick" Margin="0,0,8,8" Padding="10,7" />
                      <Button Content="定位全部抽屉" Click="LocateAllClick" Margin="0,0,8,8" Padding="10,7" />
                      <Button x:Name="RestoreAllButton" Content="归还全部内容" Click="RestoreAllClick" Margin="0,0,8,8" Padding="10,7" />
                      <Button x:Name="RecollectAllButton" Content="按分组全部收纳" Click="RecollectAllClick" Margin="0,0,8,8" Padding="10,7" />
                    </WrapPanel>
                    <Border Background="{x:Static local:AppPalette.Sidebar}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                      <StackPanel>
                        <TextBlock Text="本机性能记录" FontWeight="SemiBold" />
                        <TextBlock x:Name="PerformanceLabel" Foreground="{x:Static local:AppPalette.Secondary}" FontSize="11" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" />
                        <TextBlock Text="CPU 按整机逻辑处理器数归一；记录仅保存在本机。" FontSize="10" Foreground="{x:Static local:AppPalette.Quiet}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Button Content="打开日志目录" Click="OpenLogsClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,6" Margin="0,5,0,0" />
                      </StackPanel>
                    </Border>
                    <DockPanel Margin="0,0,0,10">
                      <Button DockPanel.Dock="Right" Content="重新检查" Click="RefreshRecoveryClick" Style="{StaticResource QuietButton}" Padding="8,4" />
                      <TextBlock x:Name="RecoveryCountLabel" Text="检查中…" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ItemsControl x:Name="RecoveryList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{x:Static local:AppPalette.Divider}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding DrawerName}"/><Run Text=" / "/><Run Text="{Binding Name}"/></TextBlock>
                              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#9A3412" FontSize="11" Margin="0,6,0,6" />
                              <TextBlock Text="{Binding Location}" TextWrapping="Wrap" FontSize="10" Foreground="{x:Static local:AppPalette.Muted}" />
                              <WrapPanel Margin="0,10,0,0">
                                <Button Content="查看桌面位置" Tag="original" Click="OpenRecoveryLocation" Margin="0,0,6,4" Padding="8,5" FontSize="11" />
                                <Button Content="查看收纳位置" Tag="stored" Click="OpenRecoveryLocation" Margin="0,0,6,4" Padding="8,5" FontSize="11" />
                                <Button Content="检查并重试" Click="RetryProblemClick" Margin="0,0,6,4" Padding="8,5" FontSize="11" />
                                <Button Content="另存收纳副本" Click="ExportProblemClick" Margin="0,0,6,4" Padding="8,5" FontSize="11" />
                                <Button Content="移除失效记录" Click="DismissMissingProblemClick" Margin="0,0,6,4" Padding="8,5" FontSize="11">
                                  <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanDismiss}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Button.Style>
                                </Button>
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel x:Name="AboutSettingsPage" Visibility="Collapsed">
                    <TextBlock Text="栖格 Qige" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="给桌面留点空。" Foreground="{x:Static local:AppPalette.Muted}" Margin="0,8,0,10" />
                    <TextBlock x:Name="VersionLabel" Foreground="{x:Static local:AppPalette.Quiet}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,24" />
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="数据位置" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBox x:Name="SettingsDataPath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="11" AutomationProperties.Name="当前数据目录" />
                        <TextBlock Text="配置、收纳内容与恢复记录保存在此目录。更新和迁移时请保留整个目录。" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,12" />
                        <Button Content="打开数据目录" Click="OpenDataClick" HorizontalAlignment="Left" Padding="10,7" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="帮助与体验" FontWeight="SemiBold" Margin="0,4,0,12" />
                    <WrapPanel>
                      <Button Content="使用指南" Click="OpenGuideClick" Margin="0,0,8,8" />
                      <Button Content="打开隔离样例" Click="DemoClick" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="样例使用独立内容，可体验界面与布局操作。" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0" />
                    <TextBlock Text="项目与支持" FontWeight="SemiBold" Margin="0,22,0,10" />
                    <WrapPanel>
                      <Button Content="项目主页" Click="OpenProjectClick" Margin="0,0,8,8" />
                      <Button Content="爱发电支持" Click="SupportProjectClick" Margin="0,0,8,8" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
        <Border x:Name="CloseBox" Visibility="Collapsed" Background="White" CornerRadius="16" Width="450" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="关闭管理面板" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Text="选择桌面抽屉接下来如何运行。" Foreground="{x:Static local:AppPalette.Muted}" Margin="0,0,0,20" />
            <Button Click="KeepRunningClick" Background="{x:Static local:AppPalette.Sidebar}" Padding="16,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="关闭面板，保持桌面抽屉运行" FontWeight="SemiBold" />
                <TextBlock Text="可从系统托盘重新打开管理面板" Foreground="{x:Static local:AppPalette.Muted}" FontSize="11" Margin="0,6,0,0" />
              </StackPanel>
            </Button>
            <Button Click="ExitClick" Background="{x:Static local:AppPalette.Control}" Padding="16,14">
              <StackPanel>
                <TextBlock Text="完全退出栖格，归还全部内容" />
                <TextBlock Text="若发生归还冲突，将保留恢复记录并提示" Foreground="{x:Static local:AppPalette.Quiet}" FontSize="11" Margin="0,6,0,0" />
              </StackPanel>
            </Button>
            <Button Content="取消" Click="DismissModalClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,16,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
