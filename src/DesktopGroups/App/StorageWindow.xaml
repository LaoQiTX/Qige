                    <ComboBox x:Name="TargetMonitorBox" DisplayMemberPath="Label" SelectionChanged="TargetMonitorChanged" FontSize="11" Padding="7,5" Margin="0,0,0,12" AutomationProperties.Name="目标显示器" />
                    <UniformGrid Columns="2">
                      <StackPanel Margin="0,0,8,10">
                        <TextBlock Text="横向位置" FontSize="10" Foreground="{x:Static local:AppPalette.Quiet}" />
                        <TextBox x:Name="XBox" TextChanged="LayoutFieldChanged" AutomationProperties.Name="横向位置" />
                      </StackPanel>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="纵向位置" FontSize="10" Foreground="{x:Static local:AppPalette.Quiet}" />
                        <TextBox x:Name="YBox" TextChanged="LayoutFieldChanged" AutomationProperties.Name="纵向位置" />
                      </StackPanel>
                      <StackPanel Margin="0,0,8,10">
                        <TextBlock Text="宽度" FontSize="10" Foreground="{x:Static local:AppPalette.Quiet}" />
                        <TextBox x:Name="WidthBox" TextChanged="LayoutFieldChanged" AutomationProperties.Name="抽屉宽度" />
                      </StackPanel>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="高度" FontSize="10" Foreground="{x:Static local:AppPalette.Quiet}" />
                        <TextBox x:Name="HeightBox" TextChanged="LayoutFieldChanged" AutomationProperties.Name="抽屉高度" />
                      </StackPanel>
                    </UniformGrid>
                    <Button x:Name="ApplyLayoutButton" Content="应用布局" Click="ApplyLayoutClick" HorizontalAlignment="Right" />
                    <TextBlock x:Name="LayoutError" Style="{StaticResource InputError}" />
                    <local:LayoutOverview x:Name="Overview" Height="110" Margin="0,12,0,0" />
                    <TextBlock Text="桌面布局 · 点击预览切换抽屉" FontSize="10" Foreground="{x:Static local:AppPalette.Quiet}" Margin="0,6,0,0" />
                  </StackPanel>
                </Expander>
                <TextBlock Text="抽屉操作" FontWeight="SemiBold" Margin="0,2,0,10" />
                <Button x:Name="LocateDrawerButton" Content="桌面定位" Click="LocateClick" Margin="0,0,0,8" />
                <Button x:Name="RestoreDrawerButton" Content="归还此抽屉的内容" Click="RestoreClick" Background="{x:Static local:AppPalette.Control}" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="RecollectDrawerButton" Content="按分组重新收纳" Click="RecollectClick" FontSize="11" Padding="8,7" />
