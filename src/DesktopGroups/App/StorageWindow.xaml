              <Button x:Name="ConfirmPreferenceSyncButton" Content="同步到全部抽屉" Click="ConfirmPreferenceSyncClick" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
          </StackPanel>
        </Border>
