                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Padding" Value="0" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock x:Name="StudioEmptyLabel" Text="此抽屉暂无入口，或没有匹配的搜索结果。" IsHitTestVisible="False"
                           TextWrapping="Wrap" Foreground="{x:Static local:AppPalette.Quiet}" Margin="0,30,0,0" />
              </Grid>
            </Grid>
          </Grid>
        </Grid>
        <Border Grid.Column="1" Background="White" BorderBrush="{x:Static local:AppPalette.Divider}" BorderThickness="1,0,0,0">
