            <CheckBox x:Name="SyncDensityBox" Content="图标布局密度" Margin="0,0,0,16" />
            <CheckBox x:Name="SyncTransparencyBox" Content="背景透明度（含菜单层级）" Margin="0,0,0,16" />
            <CheckBox x:Name="SyncLockBox" Content="锁定状态" IsChecked="True" Margin="0,0,0,20" />
