<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DesktopGroups</AssemblyName>
    <Product>栖格 Qige</Product>
    <Title>栖格 Qige</Title>
    <Description>轻量的 Windows 桌面分区整理工具</Description>
    <Version>0.1.0-beta.2</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <ApplicationIcon>..\..\assets\brand\qige.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../docs/user-guide.md" Link="使用说明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <InternalsVisibleTo Include="DesktopGroups.Tests" />
    <InternalsVisibleTo Include="DesktopGroups.Diagnostics" />
    <Resource Include="..\..\assets\brand\qige.ico" Link="Assets\qige.ico" />
    <Resource Include="..\..\assets\brand\qige-tray-light.ico" Link="Assets\qige-tray-light.ico" />
    <Resource Include="..\..\assets\brand\qige-tray-dark.ico" Link="Assets\qige-tray-dark.ico" />
  </ItemGroup>
</Project>
